<Page
    x:Class="HorizonXboxStarter.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid x:Name="InputSurface"
          Padding="34"
          Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="H" Foreground="#091610" FontSize="29" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="HORIZON" Foreground="{StaticResource MainTextBrush}"
                               FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="XBOX EDITION  /  DEVELOPMENT BUILD"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Padding="16,10" CornerRadius="10"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStatusText" Text="STARTER SHELL"
                           Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
            </Border>
        </Grid>

        <!-- Main layout -->
        <Grid Grid.Row="1" ColumnSpacing="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <StackPanel Grid.Column="0" Spacing="10">
                <TextBlock Text="MENU" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" FontWeight="Bold" Margin="6,0,0,4" />
                <Button x:Name="NavHomeButton" Content="HOME" Style="{StaticResource NavButtonStyle}"
                        Click="NavHome_Click" AutomationProperties.Name="Home" />
                <Button x:Name="NavInputButton" Content="INPUT TEST" Style="{StaticResource NavButtonStyle}"
                        Click="NavInput_Click" AutomationProperties.Name="Input test" />
                <Button x:Name="NavControlsButton" Content="CONTROLS" Style="{StaticResource NavButtonStyle}"
                        Click="NavControls_Click" AutomationProperties.Name="Controls" />
                <Button x:Name="NavEngineButton" Content="ENGINE TEST" Style="{StaticResource NavButtonStyle}"
                        Click="NavEngine_Click" AutomationProperties.Name="Engine surface test" />
                <Button x:Name="NavAboutButton" Content="ABOUT" Style="{StaticResource NavButtonStyle}"
                        Click="NavAbout_Click" AutomationProperties.Name="About" />

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,18,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="INPUT SUPPORT" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="Keyboard and mouse" Foreground="{StaticResource MainTextBrush}"
                                   FontSize="15" />
                        <TextBlock Text="Xbox controller" Foreground="{StaticResource MainTextBrush}"
                                   FontSize="15" />
                        <TextBlock Text="Controller-friendly focus navigation"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Page content -->
            <Grid Grid.Column="1">
                <!-- Home -->
                <Grid x:Name="HomePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="18" Padding="30" Margin="0,0,14,0">
                        <StackPanel Spacing="18" VerticalAlignment="Center">
                            <TextBlock Text="BUILT FOR THE BIG SCREEN" Foreground="{StaticResource AccentBrush}"
                                       FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="Your Horizon hub." Foreground="{StaticResource MainTextBrush}"
                                       FontSize="38" FontWeight="Bold" />
                            <TextBlock Text="A redesigned Xbox-friendly app shell with controller navigation and live keyboard, mouse and gamepad input testing."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="18"
                                       TextWrapping="Wrap" MaxWidth="620" />
                            <Button x:Name="OpenInputButton" Content="OPEN INPUT TEST"
                                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                                    Click="NavInput_Click" />
                            <TextBlock Text="Use the D-pad or left stick to move between buttons. Press A to select. Press B or Escape to return home."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="14">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="22">
                            <StackPanel Spacing="10">
                                <TextBlock Text="APP STATUS" Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock x:Name="AppStatusText" Text="UWP shell is running."
                                           Foreground="{StaticResource MainTextBrush}" FontSize="21"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="The app interface is ready for the next integration stage."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="NativeBridgeStatusText"
                                           Text="Native input bridge: not loaded."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="22">
                            <StackPanel Spacing="9">
                                <TextBlock Text="GAME ENGINE" Foreground="{StaticResource WarningBrush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Not connected yet" Foreground="{StaticResource MainTextBrush}"
                                           FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="This build improves the UWP interface. It does not contain Horizon's Rust game engine yet."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Input test -->
                <ScrollViewer x:Name="InputPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="0,0,8,8">
                        <StackPanel Spacing="6" Margin="0,0,0,4">
                            <TextBlock Text="INPUT TEST" Foreground="{StaticResource AccentBrush}"
                                       FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="Check every device." Foreground="{StaticResource MainTextBrush}"
                                       FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="Keyboard actions and mouse movement, buttons and wheel can be tested here."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="16"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="20">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="KEYBOARD" Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="KeyText" Text="Press any key"
                                               Foreground="{StaticResource MainTextBrush}" FontSize="23"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="KeyStateText" Text="Key state: waiting"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="MouseCaptureSurface" Grid.Column="1" Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="20" MinHeight="150"
                                    PointerMoved="InputSurface_PointerMoved"
                                    PointerPressed="InputSurface_PointerPressed"
                                    PointerReleased="InputSurface_PointerReleased"
                                    PointerWheelChanged="InputSurface_PointerWheelChanged">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="MOUSE / POINTER" Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="MouseText" Text="Move or click"
                                               Foreground="{StaticResource MainTextBrush}" FontSize="23"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MouseStateText" Text="Mouse: waiting"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                                    <TextBlock x:Name="MouseDeltaText" Text="Move the mouse here to test look delta."
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="22">
                            <StackPanel Spacing="10">
                                <TextBlock Text="XBOX CONTROLLER" Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock x:Name="ControllerStatusText" Text="Looking for a connected controller..."
                                           Foreground="{StaticResource MainTextBrush}" FontSize="21"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ControllerButtonsText" Text="Buttons: —"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ControllerAxesText"
                                           Text="Left stick: 0.00, 0.00   Right stick: 0.00, 0.00"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="TriggerText" Text="Triggers: 0.00 / 0.00"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="15" />
                                <TextBlock Text="The app polls controller state for this test. Game input mapping will be added with the game engine."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Custom keyboard and mouse controls -->
                <ScrollViewer x:Name="ControlsPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="0,0,8,8">
                        <StackPanel Spacing="6" Margin="0,0,0,4">
                            <TextBlock Text="CONTROLS" Foreground="{StaticResource AccentBrush}"
                                       FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="Keyboard and mouse setup." Foreground="{StaticResource MainTextBrush}"
                                       FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="Horizon-style defaults. Changes are saved on this device."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="16"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="22">
                            <StackPanel Spacing="12">
                                <TextBlock Text="MOUSE" Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Left click: attack / break    Right click: use / place    Middle click: pick block"
                                           Foreground="{StaticResource MainTextBrush}" FontSize="16"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Mouse sensitivity" Foreground="{StaticResource MainTextBrush}"
                                           FontSize="15" FontWeight="SemiBold" />
                                <Slider x:Name="MouseSensitivitySlider" Minimum="10" Maximum="200"
                                        Value="100" StepFrequency="5" ValueChanged="MouseSensitivitySlider_ValueChanged" />
                                <TextBlock x:Name="MouseSensitivityValueText" Text="100%"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                                <CheckBox x:Name="InvertMouseYCheckBox" Content="Invert mouse Y"
                                          Foreground="{StaticResource MainTextBrush}"
                                          Checked="InvertMouseYCheckBox_Changed"
                                          Unchecked="InvertMouseYCheckBox_Changed" />
                                <StackPanel x:Name="MouseBindingsPanel" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="22">
                            <StackPanel Spacing="12">
                                <TextBlock Text="KEY BINDINGS" Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Choose a new key for each action. F1–F12 are available in the selectors."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="KeyBindingsPanel" Spacing="7" />
                                <Button Content="RESET ALL CONTROLS" Style="{StaticResource NavButtonStyle}"
                                        HorizontalAlignment="Left" Click="ResetBindings_Click" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="22">
                            <StackPanel Spacing="8">
                                <TextBlock Text="INPUT STATUS" Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock x:Name="LastInputActionText" Text="Press a mapped key to test it."
                                           Foreground="{StaticResource MainTextBrush}" FontSize="17"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="These controls are saved and the UWP shell can read them. They will drive Minecraft only after the Horizon game engine is integrated."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>


                <!-- UWP DX12 / SwapChainPanel surface test -->
                <Grid x:Name="EnginePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="10" Margin="0,0,0,14">
                        <TextBlock Text="NATIVE GRAPHICS TEST" Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="UWP composition surface" Foreground="{StaticResource MainTextBrush}"
                                   FontSize="30" FontWeight="Bold" />
                        <TextBlock Text="Starts the pinned Horizon Rust client on a DirectX 12 SwapChainPanel. Use the controls below with a keyboard, mouse or Xbox controller. Minecraft resources must already be available to the app."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                                   TextWrapping="Wrap" />
                        <Button x:Name="EngineSurfaceButton" Content="START HORIZON"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                                Click="EngineSurfaceButton_Click" />
                        <TextBlock x:Name="EngineSurfaceStatusText" Text="Horizon is stopped."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="2">
                        <SwapChainPanel x:Name="EngineSwapChainPanel"
                                        SizeChanged="EngineSwapChainPanel_SizeChanged"
                                        PointerPressed="EngineSwapChainPanel_PointerPressed"
                                        PointerReleased="EngineSwapChainPanel_PointerReleased"
                                        PointerMoved="EngineSwapChainPanel_PointerMoved"
                                        PointerWheelChanged="EngineSwapChainPanel_PointerWheelChanged" />
                    </Border>
                </Grid>

                <!-- About -->
                <Grid x:Name="AboutPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="ABOUT THIS BUILD" Foreground="{StaticResource AccentBrush}"
                                       FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="A stronger starting point." Foreground="{StaticResource MainTextBrush}"
                                       FontSize="32" FontWeight="Bold" />
                        </StackPanel>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock Text="WHAT'S INCLUDED" Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="• TV-sized Home, Input Test and About screens"
                                           Foreground="{StaticResource MainTextBrush}" FontSize="17" />
                                <TextBlock Text="• Controller-friendly focus and button navigation"
                                           Foreground="{StaticResource MainTextBrush}" FontSize="17" />
                                <TextBlock Text="• Live gamepad buttons, sticks and trigger readings"
                                           Foreground="{StaticResource MainTextBrush}" FontSize="17" />
                                <TextBlock Text="• Keyboard and mouse input diagnostics"
                                           Foreground="{StaticResource MainTextBrush}" FontSize="17" />
                                <TextBlock Text="• Editable key bindings, F1–F12 and saved mouse sensitivity"
                                           Foreground="{StaticResource MainTextBrush}" FontSize="17" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="24">
                            <StackPanel Spacing="9">
                                <TextBlock Text="WHAT'S STILL NEEDED" Foreground="{StaticResource WarningBrush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="The Horizon Rust engine must be ported and connected before this app can start Minecraft. The Android launcher uses Android-specific services and a Vulkan renderer, so a Windows/Xbox port needs separate platform work."
                                           Foreground="{StaticResource MainTextBrush}" FontSize="16"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="HORIZON XBOX  •  UWP SHELL PREVIEW"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="D-PAD / STICK: MOVE     A: SELECT     B: BACK"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
